---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categories = games
  .flatMap((game) => (game.category ? [game.category] : []))
  .filter((category, index, allCategories) => (
    allCategories.findIndex((item) => item.id === category.id) === index
  ))
  .sort((a, b) => a.name.localeCompare(b.name));
const publishers = games
  .flatMap((game) => (game.publisher ? [game.publisher] : []))
  .filter((publisher, index, allPublishers) => (
    allPublishers.findIndex((item) => item.id === publisher.id) === index
  ))
  .sort((a, b) => a.name.localeCompare(b.name));
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <div class="flex flex-col gap-4 mb-6 sm:flex-row sm:items-end sm:justify-between">
        <h2 class="text-2xl font-medium text-slate-100">Featured Games</h2>

        <form class="grid grid-cols-1 gap-3 sm:grid-cols-2" data-testid="game-filters">
          <div>
            <label for="category-filter" class="block mb-1 text-sm font-medium text-slate-300">
              Category
            </label>
            <select
              id="category-filter"
              class="w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-sm text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
              data-testid="category-filter"
            >
              <option value="">All categories</option>
              {categories.map((category) => <option value={category.id}>{category.name}</option>)}
            </select>
          </div>

          <div>
            <label for="publisher-filter" class="block mb-1 text-sm font-medium text-slate-300">
              Publisher
            </label>
            <select
              id="publisher-filter"
              class="w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-sm text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
              data-testid="publisher-filter"
            >
              <option value="">All publishers</option>
              {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
            </select>
          </div>

          <button
            type="reset"
            class="sm:col-span-2 justify-self-start text-sm font-medium text-blue-400 transition-colors hover:text-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-500"
            data-testid="reset-filters"
          >
            Clear filters
          </button>
        </form>
      </div>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      )}
      <p
        class="mt-8 text-center text-slate-300"
        data-testid="no-filter-results"
        hidden
      >
        No games match the selected filters.
      </p>
    </div>
  </div>
</Layout>

<script>
  const filterForm = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const categoryFilter = document.querySelector<HTMLSelectElement>('[data-testid="category-filter"]');
  const publisherFilter = document.querySelector<HTMLSelectElement>('[data-testid="publisher-filter"]');
  const gameCards = document.querySelectorAll<HTMLElement>('[data-testid="game-card"]');
  const noResults = document.querySelector<HTMLElement>('[data-testid="no-filter-results"]');

  function applyFilters(): void {
    const categoryId = categoryFilter?.value ?? '';
    const publisherId = publisherFilter?.value ?? '';
    let visibleCount = 0;

    gameCards.forEach((card) => {
      const matchesCategory = !categoryId || card.dataset.categoryId === categoryId;
      const matchesPublisher = !publisherId || card.dataset.publisherId === publisherId;
      const isVisible = matchesCategory && matchesPublisher;

      card.hidden = !isVisible;
      if (isVisible) {
        visibleCount += 1;
      }
    });

    if (noResults) {
      noResults.hidden = visibleCount > 0;
    }
  }

  categoryFilter?.addEventListener('change', applyFilters);
  publisherFilter?.addEventListener('change', applyFilters);
  filterForm?.addEventListener('reset', () => {
    requestAnimationFrame(applyFilters);
  });
</script>
